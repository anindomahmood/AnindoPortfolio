@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="container section" style="padding-top: 96px;">
    <h1 class="h2">Something went wrong.</h1>
    <p class="lead">An error occurred while processing your request.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted mono">Request ID: @Model.RequestId</p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</section>
