<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <meta name="theme-color" content="#0A0F1C" />
    <title>@ViewData["Title"] · Anindo Mahmood</title>
    <meta name="description" content="Anindo Mahmood: ML researcher and developer. Research in healthcare prediction and environmental monitoring." />

    @* Apply the saved theme before the page paints, so there is no flash *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/overrides.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <nav class="nav container" aria-label="Main">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true" style="border: 0; border-radius: 50%; width: 42px; height: 42px;">
                    <svg width="42" height="42" viewBox="0 0 120 120" fill="none">
                        <circle cx="60" cy="60" r="54" stroke="currentColor" stroke-width="5" />
                        <path d="M36 90 L60 28 L84 90" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M18 68 H42 L49 56 L56 80 L63 60 L67 68 H102" style="stroke: var(--amber)" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span class="brand-name" style="font-size: 21px;">Anindo Mahmood</span>
            </a>

            <button type="button" class="icon-btn menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>

            <div class="nav-links" id="navLinks">
                <a href="/#research">Research</a>
                <a href="/#results">Results</a>
                <a href="/#projects">Projects</a>
                <a href="/#skills">Skills</a>
                <a href="/#journey">Journey</a>
                <a href="/#contact">Contact</a>
                <button type="button" class="icon-btn theme-btn" id="themeBtn" aria-label="Switch to light theme" title="Switch theme">
                    <svg class="icon-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
                    <svg class="icon-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                </button>
                <a class="btn btn-primary btn-sm" href="~/files/Anindo_Mahmood_CV.pdf" download>Download CV</a>
            </div>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer container">
        <span class="footer-left">© @DateTime.Now.Year Anindo Mahmood
            <a href="/workspace" class="footer-ws" aria-label="Open workspace" title="Workspace">
                <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>
            </a>
        </span>
        <span class="mono">Reference available: Md Sajid Hossain, Senior Assistant Professor, AIUB</span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
