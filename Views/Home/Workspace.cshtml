@{
    ViewData["Title"] = "Workspace";
}
<link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />

<div class="container ws">

    <!-- ============ HEADER ============ -->
    <section class="ws-head">
        <div class="ws-head-text">
            <div class="mono muted small" id="wsDate">Today</div>
            <h1 class="sr-only">Workspace</h1>
            <p class="ws-title" id="wsQuote">Let’s make today count.</p>
            <p class="body">Notes, quick maths and print-ready pages. Everything is saved in this browser only.</p>
        </div>
        <div class="ws-backup">
            <button type="button" class="ws-btn-ghost sm" id="wsExport">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
                Export backup
            </button>
            <button type="button" class="ws-btn-ghost sm" id="wsImportBtn">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V9M7 14l5-5 5 5M5 3h14" /></svg>
                Import backup
            </button>
            <input type="file" id="wsImport" accept="application/json" hidden />
        </div>
    </section>

    <!-- ============ THE THREE TOOLS ============ -->
    <section class="ws-tools">

        <!-- ---------- Quick notes ---------- -->
        <div class="ws-card notes-card">
            <div class="ws-card-head">
                <div class="ws-title-row">
                    <span class="ws-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></svg></span>
                    <div><h2 class="ws-h2">Quick notes</h2><span class="muted small" id="noteCount">0 notes</span></div>
                </div>
            </div>

            <form class="ws-composer" id="noteForm" autocomplete="off">
                <div class="ws-row">
                    <label for="noteTitle" class="sr-only">Note title</label>
                    <input id="noteTitle" class="ws-input grow" placeholder="Title" maxlength="80" />
                    <div class="ws-cat" id="catPicker">
                        <input type="hidden" id="noteCat" value="research" />
                        <button type="button" class="ws-cat-btn" id="catBtn" aria-haspopup="listbox" aria-expanded="false" aria-label="Category">
                            <i class="ws-dot research" id="catDot"></i><span id="catLabel">Research</span>
                        </button>
                        <div class="ws-cat-menu" id="catMenu" role="listbox" aria-label="Category" hidden>
                            <span class="ws-cat-head">Category</span>
                            <button type="button" role="option" data-val="research"><i class="ws-dot research"></i><span>Research</span><svg class="ws-check" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></button>
                            <button type="button" role="option" data-val="class"><i class="ws-dot class"></i><span>Class</span><svg class="ws-check" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></button>
                            <button type="button" role="option" data-val="ideas"><i class="ws-dot ideas"></i><span>Ideas</span><svg class="ws-check" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg></button>
                        </div>
                    </div>
                </div>
                <label for="noteText" class="sr-only">Note text</label>
                <textarea id="noteText" class="ws-input ws-textarea" placeholder="Write a note…" maxlength="1000"></textarea>
                <div class="ws-row end">
                    <button type="button" class="ws-btn-ghost sm" id="noteCancel" hidden>Cancel</button>
                    <button type="submit" class="ws-btn-primary sm" id="noteSave">Save note</button>
                </div>
            </form>

            <div class="ws-search">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                <label for="noteSearch" class="sr-only">Search notes</label>
                <input id="noteSearch" placeholder="Search notes" />
            </div>
            <div class="ws-chips" role="group" aria-label="Note filter" id="noteFilter">
                <button type="button" class="ws-chip is-active" data-cat="all">All</button>
                <button type="button" class="ws-chip" data-cat="research">Research</button>
                <button type="button" class="ws-chip" data-cat="class">Class</button>
                <button type="button" class="ws-chip" data-cat="ideas">Ideas</button>
            </div>
            <div class="ws-notes" id="noteList"></div>
        </div>

        <!-- ---------- Calculator ---------- -->
        <div class="ws-card calc-card">
            <div class="ws-card-head">
                <div class="ws-title-row">
                    <span class="ws-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" /><path d="M8 6h8M8 11h.01M12 11h.01M16 11h.01M8 15h.01M12 15h.01M16 15h.01M8 19h.01M12 19h4" /></svg></span>
                    <h2 class="ws-h2">Calculator</h2>
                </div>
                <div class="ws-seg" role="group" aria-label="Calculator mode">
                    <button type="button" class="ws-seg-btn is-active" data-calc-mode="basic">Basic</button>
                    <button type="button" class="ws-seg-btn" data-calc-mode="sci">Sci</button>
                </div>
            </div>
            <div class="calc-display">
                <div class="calc-history mono" id="calcHistory">&nbsp;</div>
                <div class="calc-expr mono" id="calcExpr">&nbsp;</div>
                <div class="calc-result" id="calcResult" aria-live="polite">0</div>
            </div>
            <div class="calc-sci" id="calcSci" hidden>
                <button type="button" class="calc-key sci" data-k="√">√</button>
                <button type="button" class="calc-key sci" data-k="²">x²</button>
                <button type="button" class="calc-key sci" data-k="π">π</button>
                <button type="button" class="calc-key sci" data-k="%">%</button>
            </div>
            <div class="calc-keys">
                <button type="button" class="calc-key fn amber" data-k="AC">AC</button>
                <button type="button" class="calc-key fn" data-k="⌫" aria-label="Backspace">⌫</button>
                <button type="button" class="calc-key fn" data-k="()" aria-label="Brackets">( )</button>
                <button type="button" class="calc-key op" data-k="÷" aria-label="Divide">÷</button>
                <button type="button" class="calc-key" data-k="7">7</button>
                <button type="button" class="calc-key" data-k="8">8</button>
                <button type="button" class="calc-key" data-k="9">9</button>
                <button type="button" class="calc-key op" data-k="×" aria-label="Multiply">×</button>
                <button type="button" class="calc-key" data-k="4">4</button>
                <button type="button" class="calc-key" data-k="5">5</button>
                <button type="button" class="calc-key" data-k="6">6</button>
                <button type="button" class="calc-key op" data-k="−" aria-label="Subtract">−</button>
                <button type="button" class="calc-key" data-k="1">1</button>
                <button type="button" class="calc-key" data-k="2">2</button>
                <button type="button" class="calc-key" data-k="3">3</button>
                <button type="button" class="calc-key op" data-k="+" aria-label="Add">+</button>
                <button type="button" class="calc-key" data-k="±" aria-label="Plus or minus">±</button>
                <button type="button" class="calc-key" data-k="0">0</button>
                <button type="button" class="calc-key" data-k="." aria-label="Decimal point">.</button>
                <button type="button" class="calc-key eq" data-k="=" aria-label="Equals">=</button>
            </div>
        </div>

        <!-- ---------- Print Studio ---------- -->
        <div class="ws-card print-card">
            <div class="ws-card-head">
                <div class="ws-title-row">
                    <span class="ws-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2M6 14h12v7H6z" /></svg></span>
                    <div><h2 class="ws-h2">Print Studio</h2><span class="muted small">Branded A4 pages</span></div>
                </div>
            </div>

            <div class="ws-field">
                <span class="ws-label">Page</span>
                <div class="tpl-options" role="radiogroup" aria-label="Page type">
                    <button type="button" class="tpl-option is-active" role="radio" aria-checked="true" data-tpl="lined">
                        <span class="tpl-name">Lined page</span>
                        <span class="muted xsmall">Ruled lines for writing</span>
                    </button>
                    <button type="button" class="tpl-option" role="radio" aria-checked="false" data-tpl="blank">
                        <span class="tpl-name">Fresh page</span>
                        <span class="muted xsmall">Clean blank paper</span>
                    </button>
                </div>
            </div>

            <div class="ws-field">
                <div class="ws-label-row"><span class="ws-label" id="docPickLabel">Content</span><span class="muted xsmall" id="docPickCount"></span></div>
                <div class="doc-pick">
                    <input type="hidden" id="docNote" value="" />
                    <div class="doc-pick-list" id="docPick" role="listbox" aria-labelledby="docPickLabel"></div>
                    <label class="doc-pick-title" for="docTitle">
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                        <span class="sr-only">PDF title</span>
                        <input id="docTitle" value="Research notes" maxlength="80" placeholder="PDF title" />
                    </label>
                </div>
            </div>

            <div class="ws-field">
                <span class="ws-label">Include</span>
                <div class="ws-toggles">
                    <label class="ws-toggle"><span class="ws-toggle-text">Date</span><input type="checkbox" id="docDate" checked /><span class="ws-switch" aria-hidden="true"></span></label>
                    <label class="ws-toggle"><span class="ws-toggle-text">Page number</span><input type="checkbox" id="docPage" checked /><span class="ws-switch" aria-hidden="true"></span></label>
                </div>
            </div>

            <div class="print-actions">
                <button type="button" class="ws-btn-primary" id="docPdf">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
                    Export PDF
                </button>
                <button type="button" class="ws-btn-ghost" id="docPrint">Print</button>
                <p class="muted xsmall">Export PDF opens the print window. Choose <strong>“Save as PDF”</strong> as the printer.</p>
            </div>
        </div>
    </section>
</div>

<!-- Printable A4 sheet (moved to <body> by the script, shown only when printing) -->
<div id="printSheet" class="print-sheet" aria-hidden="true">
    <header class="ps-head">
        <svg width="46" height="46" viewBox="0 0 120 120" fill="none" aria-hidden="true"><circle cx="60" cy="60" r="54" stroke="#0F766E" stroke-width="5" /><path d="M36 90 L60 28 L84 90" stroke="#0F766E" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" /><path d="M18 68 H42 L49 56 L56 80 L63 60 L67 68 H102" stroke="#B45309" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <div class="ps-name"><strong>Anindo Mahmood</strong><span>Machine Learning · Researcher · Developer</span></div>
        <div class="ps-meta"><span id="psDate"></span><span id="psType"></span></div>
    </header>
    <div class="ps-rule"><span></span><span></span></div>
    <h1 class="ps-title" id="psTitle">Research notes</h1>
    <div class="ps-body" id="psBody"></div>
    <footer class="ps-foot"><span><i></i>anindomahmood.runasp.net</span><span id="psPage">Page 1 of 1</span></footer>
</div>

@section Scripts {
    <script src="~/js/workspace.js" asp-append-version="true"></script>
}
