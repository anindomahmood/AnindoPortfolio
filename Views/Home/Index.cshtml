@model HomeViewModel
@{
    ViewData["Title"] = "Research Portfolio";
    var inv = CultureInfo.InvariantCulture;
    var firstFocus = Model.FocusAreas[0];
    var bestModel = Model.HeartModels.OrderByDescending(m => m.Accuracy).First();
    string Pos(double acc) => ((acc - 85) / 7 * 100).ToString("0.0", inv);   // chart axis 85–92
}

<div class="container">

    <!-- ============ HERO ============ -->
    <section class="hero" id="top">
        <div class="hero-text">
            <div class="eyebrow-live"><span class="live-dot"></span>Final-year CSE · Information Systems · AIUB, Dhaka</div>
            <h1 class="hero-title">Machine learning for <span class="accent">healthcare</span> and the <span class="amber">environment</span>.</h1>
            <p class="lead">I'm Anindo Mahmood, an ML researcher and developer. I build predictive models on public datasets, check them carefully, and turn them into tools people can use, from IoT climate stations to clinical risk classifiers.</p>
            <div class="btn-row">
                <a class="btn btn-primary" href="#research">Explore research</a>
                <a class="btn btn-ghost" href="https://github.com/anindomahmood" target="_blank" rel="noopener">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" /></svg>
                    GitHub
                </a>
            </div>
            <div class="stats">
                <div><div class="stat-num" data-count="1">1</div><div class="stat-label">IEEE paper accepted</div></div>
                <div><div class="stat-num" data-count="@Model.Papers.Count">@Model.Papers.Count</div><div class="stat-label">research works</div></div>
                <div><div class="stat-num" data-count="@Model.Projects.Count">@Model.Projects.Count</div><div class="stat-label">projects shipped</div></div>
                <div><div class="stat-num" data-count="3.51" data-decimals="2">3.51</div><div class="stat-label">CGPA · 113/148 cr</div></div>
            </div>
        </div>

        <div class="hero-side">
            <!-- Draggable research robot -->
            <div class="robot-stage" id="robotStage" role="application" aria-label="Research robot playground: drag the robot with your mouse, click it for a research fact">
                <div class="robot-glow" id="robotGlow" aria-hidden="true"></div>
                <span class="particle" style="left:12%;bottom:8%" aria-hidden="true">0.9076</span>
                <span class="particle" style="left:78%;bottom:14%;animation-delay:2s" aria-hidden="true">SHAP</span>
                <span class="particle" style="left:46%;bottom:4%;animation-delay:4s" aria-hidden="true">n=6103</span>
                <span class="particle" style="left:88%;bottom:40%;animation-delay:1s" aria-hidden="true">ESP32</span>
                <div class="stage-label"><span class="live-dot small accent-bg"></span>R-01 · research assistant</div>
                <div class="stage-coords mono" id="robotCoords">x 50 · y 56</div>

                <div class="robot" id="robot">
                    <div class="robot-bubble" id="robotBubble" aria-live="polite">@Model.RobotFacts[0]</div>
                    <button type="button" class="robot-btn" id="robotBtn" aria-label="Research robot. Drag to move, click for a fact">
                        <span class="bot-bob">
                            <svg aria-hidden="true" width="150" height="170" viewBox="0 0 200 226" fill="none" style="overflow: visible">
                                <line x1="100" y1="34" x2="100" y2="14" stroke="#64748B" stroke-width="4" stroke-linecap="round" />
                                <circle class="bot-led bot-accent" cx="100" cy="11" r="8" />
                                <rect x="22" y="58" width="14" height="34" rx="6" fill="#334155" />
                                <rect x="164" y="58" width="14" height="34" rx="6" fill="#334155" />
                                <rect x="34" y="34" width="132" height="84" rx="26" fill="#E2E8F0" />
                                <rect x="46" y="46" width="108" height="60" rx="18" fill="#0F172A" />
                                <g id="robotEyes">
                                    <g class="bot-eyes">
                                        <circle class="bot-accent" cx="78" cy="74" r="10" />
                                        <circle class="bot-accent" cx="122" cy="74" r="10" />
                                        <circle cx="81" cy="71" r="3" fill="#F0FDFA" />
                                        <circle cx="125" cy="71" r="3" fill="#F0FDFA" />
                                    </g>
                                </g>
                                <path id="robotMouth" class="bot-accent-stroke" d="M90 95 Q100 100 110 95" stroke-width="3" stroke-linecap="round" />
                                <rect x="88" y="118" width="24" height="10" rx="3" fill="#64748B" />
                                <g class="bot-arm" id="robotArm">
                                    <rect x="24" y="136" width="18" height="52" rx="9" fill="#CBD5E1" />
                                    <circle cx="33" cy="192" r="9" fill="#94A3B8" />
                                </g>
                                <rect x="158" y="136" width="18" height="52" rx="9" fill="#CBD5E1" />
                                <circle cx="167" cy="192" r="9" fill="#94A3B8" />
                                <rect x="46" y="128" width="108" height="78" rx="22" fill="#E2E8F0" />
                                <rect x="62" y="142" width="76" height="46" rx="10" fill="#0F172A" />
                                <rect class="bot-bar b1 bot-accent" x="72" y="152" width="12" height="28" rx="3" />
                                <rect class="bot-bar b2" x="94" y="152" width="12" height="28" rx="3" fill="#FBBF24" />
                                <rect class="bot-bar b3 bot-accent" x="116" y="152" width="12" height="28" rx="3" />
                                <circle cx="100" cy="198" r="3" fill="#94A3B8" />
                            </svg>
                        </span>
                    </button>
                    <span class="bot-shadow" aria-hidden="true"></span>
                </div>
                <div class="stage-hint mono">drag me around · click me for a research fact</div>
            </div>

            <!-- Research focus picker -->
            <div class="panel focus-panel">
                <div class="kicker">RESEARCH FOCUS — PICK ONE</div>
                <div class="chip-row" role="group" aria-label="Research focus">
                    @foreach (var f in Model.FocusAreas)
                    {
                        <button type="button" class="chip @(f == firstFocus ? "is-active" : "")" aria-pressed="@(f == firstFocus ? "true" : "false")"
                                data-focus-title="@f.Title" data-focus-body="@f.Body" data-focus-link="@f.Link">@f.Label</button>
                    }
                </div>
                <div class="focus-detail">
                    <div class="focus-title" id="focusTitle">@firstFocus.Title</div>
                    <div class="focus-body" id="focusBody">@firstFocus.Body</div>
                    <div class="focus-link mono" id="focusLink">@firstFocus.Link</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ NOW ============ -->
    <section class="now-strip" aria-label="Currently">
        <span class="now-label mono">NOW</span>
        <span>Revising the heart-disease manuscript for resubmission</span>
        <span>Running the maternal-health risk study</span>
        <span>Planning an AI/ML undergraduate thesis</span>
        <span>Exploring MSc programs in IS, Data Science and AI</span>
    </section>

    <!-- ============ RESEARCH ============ -->
    <section class="section reveal" id="research">
        <div class="section-head">
            <div>
                <div class="section-kicker">01 / Research &amp; publications</div>
                <h2 class="h2">Papers, manuscripts and proposals</h2>
            </div>
            <div class="segmented" role="group" aria-label="Filter by status" data-filter-group="papers">
                <button type="button" class="seg is-active" aria-pressed="true" data-filter="all">All <span>@Model.Papers.Count</span></button>
                <button type="button" class="seg" aria-pressed="false" data-filter="accepted">Accepted <span>@(Model.Papers.Count(p => p.StatusKey == "accepted"))</span></button>
                <button type="button" class="seg" aria-pressed="false" data-filter="revision">In revision <span>@(Model.Papers.Count(p => p.StatusKey == "revision"))</span></button>
                <button type="button" class="seg" aria-pressed="false" data-filter="ongoing">Ongoing <span>@(Model.Papers.Count(p => p.StatusKey == "ongoing"))</span></button>
            </div>
        </div>

        <div class="paper-list" id="papers">
            @foreach (var p in Model.Papers)
            {
                <article class="card paper" data-key="@p.StatusKey">
                    <div class="paper-main">
                        <div class="meta-row">
                            <span class="badge badge-@p.StatusKey">@p.StatusLabel</span>
                            <span class="mono muted small">@p.Date</span>
                        </div>
                        <h3 class="paper-title">@p.Title</h3>
                        <div class="muted small">@p.Venue</div>
                        <div class="body small">@p.People</div>
                    </div>
                    <div class="paper-side">
                        <p class="body">@p.Summary</p>
                        <div class="tag-row">
                            @foreach (var t in p.Tags)
                            {
                                <span class="tag">@t</span>
                            }
                        </div>
                        <div class="paper-foot">
                            @if (p.DetailSlug is not null)
                            {
                                <a asp-controller="Home" asp-action="Research" asp-route-slug="@p.DetailSlug">Read the study →</a>
                            }
                            <span class="muted">@p.Metric</span>
                        </div>
                    </div>
                </article>
            }
        </div>
        <p class="muted small">Research interests: Machine Learning · AI · Data Mining · Computer Vision &amp; Pattern Recognition · Information Systems · Healthcare Prediction · Environmental Monitoring · LLMs for Software Engineering</p>
    </section>

    <!-- ============ RESULTS ============ -->
    <section class="results reveal" id="results">
        <div class="results-text">
            <div class="section-kicker">02 / Results spotlight</div>
            <h2 class="h3">Early heart-disease detection: four models, one winner</h2>
            <p class="body">Logistic Regression, Random Forest, XGBoost and CatBoost, trained on UCI Heart Disease (Cleveland, Hungary, Switzerland) and a Kaggle dataset. Select a model to see how it did.</p>
            <div class="selected-model">
                <div class="kicker">SELECTED MODEL</div>
                <div class="selected-row">
                    <span class="selected-name" id="modelName">@bestModel.Name</span>
                    <span class="selected-acc" id="modelAcc">@bestModel.Accuracy.ToString("0.00", inv)%</span>
                </div>
                <div class="body small" id="modelNote">@bestModel.Note</div>
            </div>
            <p class="muted xsmall">Accuracy from experiments so far; manuscript under revision.</p>
        </div>

        <figure class="dot-chart">
            <figcaption class="mono muted xsmall">Test accuracy (%) — axis 85 to 92</figcaption>
            @foreach (var m in Model.HeartModels)
            {
                var active = m.Id == bestModel.Id;
                <button type="button" class="dot-row @(active ? "is-active" : "")" aria-pressed="@(active ? "true" : "false")"
                        aria-label="@m.Name, @m.Accuracy.ToString("0.00", inv) percent"
                        data-name="@m.Name" data-acc="@m.Accuracy.ToString("0.00", inv)" data-note="@m.Note"
                        style="--pos: @Pos(m.Accuracy)%">
                    <span class="dot-name">@m.Name</span>
                    <span class="dot-track"><span class="dot-line"></span><span class="dot"></span></span>
                    <span class="dot-val mono">@m.Accuracy.ToString("0.00", inv)</span>
                </button>
            }
            <div class="dot-axis mono"><span></span><span class="axis-ticks"><span>85</span><span>88.5</span><span>92</span></span><span></span></div>
        </figure>
    </section>

    <!-- ============ PROJECTS ============ -->
    <section class="section reveal" id="projects">
        <div class="section-head">
            <div>
                <div class="section-kicker">03 / Projects</div>
                <h2 class="h2">Things I've built</h2>
            </div>
            <div class="chip-row" role="group" aria-label="Filter projects" data-filter-group="projects">
                @foreach (var area in new[] { "All", "ML", "Web", ".NET", "Graphics" })
                {
                    <button type="button" class="chip @(area == "All" ? "is-active" : "")" aria-pressed="@(area == "All" ? "true" : "false")" data-filter="@(area == "All" ? "all" : area)">@area</button>
                }
            </div>
        </div>
        <div class="project-grid" id="projects-list">
            @foreach (var pr in Model.Projects)
            {
                <article class="card project" data-key="@pr.Area">
                    <div class="meta-row spread">
                        <span class="mono amber small">@pr.Area</span>
                        <span class="mono muted small">@pr.When</span>
                    </div>
                    <h3 class="project-title">@pr.Name</h3>
                    <p class="body small grow">@pr.Description</p>
                    <div class="tag-row">
                        @foreach (var s in pr.Stack)
                        {
                            <span class="tag tag-fill">@s</span>
                        }
                    </div>
                    <a href="@pr.RepoUrl" target="_blank" rel="noopener" class="small strong">View repository →</a>
                </article>
            }
        </div>
    </section>

    <!-- ============ SKILLS ============ -->
    <section class="section reveal" id="skills">
        <div class="section-kicker">04 / Toolkit</div>
        <h2 class="h2">Skills</h2>
        <div class="skill-grid">
            @foreach (var g in Model.Skills)
            {
                <div class="skill-card">
                    <div class="skill-title">@g.Name</div>
                    <div class="tag-row">
                        @foreach (var it in g.Items)
                        {
                            <span class="tag tag-soft">@it</span>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ============ JOURNEY ============ -->
    <section class="section journey reveal" id="journey">
        <div class="journey-side">
            <div class="section-kicker">05 / Journey</div>
            <h2 class="h2">Education, certificates and training</h2>
            <div class="chip-row" role="group" aria-label="Timeline view" data-filter-group="timeline">
                <button type="button" class="chip is-active" aria-pressed="true" data-filter="edu">Education</button>
                <button type="button" class="chip" aria-pressed="false" data-filter="cert">Certifications</button>
                <button type="button" class="chip" aria-pressed="false" data-filter="work">Workshops</button>
            </div>
            <div class="panel">
                <div class="kicker">DEGREE PROGRESS</div>
                <div class="progress-title">113 of 148 credits · 10th semester</div>
                <div class="progress"><div class="progress-bar" style="--w: 76%"></div></div>
                <div class="muted small">76% complete · next up: Data Warehouse &amp; Data Mining, Computer Vision &amp; Pattern Recognition</div>
            </div>
        </div>
        <ol class="timeline" id="timeline-list">
            @foreach (var e in Model.Timeline)
            {
                <li data-key="@e.Category" hidden="@(e.Category != "edu")">
                    <span class="mono muted small">@e.When</span>
                    <span class="timeline-title">@e.Title</span>
                    <span class="body small">@e.Subtitle</span>
                </li>
            }
        </ol>
    </section>

    <!-- ============ CONTACT ============ -->
    <section class="contact reveal" id="contact">
        <div class="contact-text">
            <h2 class="h2">Let's research something useful together.</h2>
            <p class="body">Open to research collaborations, thesis partnerships, MSc supervision conversations and software internships in Bangladesh.</p>
            <div class="btn-row">
                <a class="btn btn-primary" href="mailto:anindomahmood1@gmail.com">Email me</a>
                <a class="btn btn-outline" href="~/files/Anindo_Mahmood_CV.pdf" download>Download CV (PDF)</a>
            </div>
        </div>
        <div class="contact-list">
            <a href="mailto:anindomahmood1@gmail.com"><span class="muted">Email</span><span>anindomahmood1@gmail.com</span></a>
            <a href="https://github.com/anindomahmood" target="_blank" rel="noopener"><span class="muted">GitHub</span><span>github.com/anindomahmood</span></a>
            <a href="https://linkedin.com/in/anindo-mahmood-9769852a8" target="_blank" rel="noopener"><span class="muted">LinkedIn</span><span>anindo-mahmood</span></a>
            <div><span class="muted">Location</span><span>Dhaka, Bangladesh</span></div>
        </div>
    </section>
</div>

@section Scripts {
    <script>window.robotFacts = @Json.Serialize(Model.RobotFacts);</script>
    <script src="~/js/robot.js" asp-append-version="true"></script>
}
